+// iOS Safari keeps a canvas's pixel memory alive until garbage collection
+// gets round to it, and caps TOTAL canvas memory. A few full-platen canvases
+// (~100 MB each) left lying around is enough to hit that cap: new canvases
+// then come back blank, getContext returns null, or the tab is killed and
+// reloads. Shrinking a canvas to 0x0 frees its memory immediately.
+export function releaseCanvas(canvas: HTMLCanvasElement | null | undefined): void {
+  if (!canvas) return;
+  canvas.width = 0;
+  canvas.height = 0;
+}
+
+// Longest side we ever keep from an imported file. The biggest platen is
+// 6300 px tall, so anything larger only costs memory — it gets scaled down
+// to fit the platen anyway.
+export const MAX_IMPORT_SIDE = 6300;
+
 export function imageDataToCanvas(imageData: ImageData): HTMLCanvasElement {
   const canvas = document.createElement('canvas');
   canvas.width = imageData.width;
@@ -38,6 +54,26 @@ export function drawImageToCanvas(img: HTMLImageElement): HTMLCanvasElement {
   return canvas;
 }
 
+// Decode an imported image straight to pixels, capped at MAX_IMPORT_SIDE,
+// through ONE canvas that is freed before returning.
+export function imageToImageData(img: HTMLImageElement, maxSide = MAX_IMPORT_SIDE): ImageData {
+  const w0 = img.naturalWidth || img.width;
+  const h0 = img.naturalHeight || img.height;
+  const s = Math.min(1, maxSide / Math.max(w0, h0));
+  const canvas = document.createElement('canvas');
+  canvas.width = Math.max(1, Math.round(w0 * s));
+  canvas.height = Math.max(1, Math.round(h0 * s));
+  try {
+    const ctx = get2dContext(canvas);
+    ctx.imageSmoothingEnabled = true;
+    ctx.imageSmoothingQuality = 'high';
+    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+    return ctx.getImageData(0, 0, canvas.width, canvas.height);
+  } finally {
+    releaseCanvas(canvas);
+  }
+}
